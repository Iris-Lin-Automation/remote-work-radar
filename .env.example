# Copy to .env and fill values. NEVER commit real tokens.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALLOWED_TELEGRAM_USER_ID=
TELEGRAM_WEBHOOK_SECRET=

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Supabase Postgres (GitHub Actions + local scripts via pg)
# Use Transaction pooler URI from Supabase Dashboard → Database → Connect
# Example host: aws-0-xxxx.pooler.supabase.com  (NOT localhost)
DATABASE_URL=

# Cloudflare Worker / REST access (never expose service_role to browsers)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Radar behaviour
RADAR_USER_KEY=iris
RADAR_REQUIRE_CLOUD_DB=true
RADAR_TRACK=both
RADAR_PRIMARY=en
RADAR_EN_THRESHOLD=40
RADAR_CN_THRESHOLD=40
RADAR_PROFILE_VERSION=v1
RADAR_PROMPT_VERSION=v1
LEGACY_EXPIRE_DAYS=45

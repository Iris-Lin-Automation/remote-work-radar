DOMESTIC_LLM_API_KEY=你的API Key填这里
DOMESTIC_LLM_BASE_URL=https://api.deepseek.com/v1
DOMESTIC_LLM_MODEL=deepseek-chat

# ──────────────────────────────────────────
# Telegram 推送配置（run-radar-cycle.js 使用）
# ──────────────────────────────────────────
# 1. 找 @BotFather 发 /newbot，拿到 Token
TELEGRAM_BOT_TOKEN=你的Bot_Token填这里

# 2. 给你的 bot 发 /start，然后访问：
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    在 result[0].message.chat.id 里找到你的 chat_id
TELEGRAM_CHAT_ID=你的chat_id填这里

# 3. 自定义关键词（逗号分隔，不填则使用脚本默认值）
#    默认包含：台湾, 跨境, QA, 数据分析, 全职远程, 香港 等
# RADAR_KEYWORDS=台湾,跨境,QA,数据,全职远程,香港,澳门

# 4. 无新帖时是否发心跳消息（true/false）
# TELEGRAM_SEND_HEARTBEAT=false

# 5. 只处理最近几小时内发布的帖子（默认 4 小时）
#    防止首次运行时把 RSS 里的旧帖全推出来
# RADAR_MAX_AGE_HOURS=4

# DeepSeek:
#   DOMESTIC_LLM_BASE_URL=https://api.deepseek.com/v1
#   DOMESTIC_LLM_MODEL=deepseek-chat
#
# 阿里云通义千问:
#   DOMESTIC_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   DOMESTIC_LLM_MODEL=qwen-turbo
#
# 月之暗面 Kimi:
#   DOMESTIC_LLM_BASE_URL=https://api.moonshot.cn/v1
#   DOMESTIC_LLM_MODEL=moonshot-v1-8k
#
# 智谱 GLM-4:
#   DOMESTIC_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   DOMESTIC_LLM_MODEL=glm-4-flash
